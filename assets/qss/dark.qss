/* Base */
QWidget {
    color: #e5e7eb;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 14px;
}

/* Home */
QWidget#homeView {
    background: #000000;
}

QLabel#homeVideoLabel {
    color: #e5e7eb;
    font-size: 24px;
    font-weight: 700;
    background: #000000;
    padding: 8px 12px;
    border-radius: 8px;
}

QPushButton#homeSettingBtn {
    background: #2f2f2f;
    color: #f3f4f6;
    border: 1px solid #5a5a5a;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
}

QPushButton#homeSettingBtn:hover {
    background: #3b3b3b;
}

QPushButton#homeSettingBtn:pressed {
    background: #242424;
}

QPushButton#homeExitBtn {
    background: #dc2626;
    color: #ffffff;
    border-radius: 8px;
    border: none;
    font-size: 16px;
    font-weight: 700;
}

QPushButton#homeExitBtn:hover {
    background: #b91c1c;
}

QPushButton#homeExitBtn:pressed {
    background: #991b1b;
}

QPlainTextEdit#homeDebugInfo {
    background-color: rgba(17, 17, 17, 180);
    color: #e5e7eb;
}

QPushButton#homeRecordStopBtn {
    background: #dc2626;
    color: #ffffff;
    border: none;
    border-radius: 14px;
    font-size: 28px;
    font-weight: 700;
    padding: 16px 20px;
    text-align: center;
}

QPushButton#homeRecordStopBtn:hover {
    background: #b91c1c;
}

QPushButton#homeRecordStopBtn:pressed {
    background: #991b1b;
}

QWidget#homeCallBlockOverlay {
    background-color: rgba(0, 0, 0, 96);
}

QFrame#homeModelFilesHint {
    background: rgba(12, 12, 12, 0.95);
    border: 1px solid #3f3f46;
    border-radius: 8px;
}

QLabel#homeModelFilesHintText {
    color: #f3f4f6;
    font-size: 16px;
    font-weight: 600;
}

QLabel#homeModelFilesHintIcon {
    background: transparent;
}

QPushButton#homeCallCloseBtn {
    background: #d92d20;
    color: #ffffff;
    border: none;
    border-radius: 18px;
    font-size: 36px;
    font-weight: 700;
    padding: 24px 36px;
}

QPushButton#homeCallCloseBtn:hover {
    background: #b42318;
}

QPushButton#homeCallCloseBtn:pressed {
    background: #912018;
}

/* Setting popup */
QWidget#settingOverlay {
    background-color: rgba(0, 0, 0, 120);
}

QFrame#settingPanel {
    background: #262626;
    border-radius: 12px;
}

QLabel#settingTitle {
    font-size: 22px;
    font-weight: 700;
    color: #f9fafb;
}

QFrame#settingLeftNav {
    background: #2a2a2a;
    border: 1px solid #3c3c3c;
    border-radius: 10px;
}

QScrollArea#settingLeftScroll,
QScrollArea#settingRightScroll {
    background: transparent;
}

QFrame#settingCenterDivider {
    background: #4a4a4a;
    min-width: 1px;
    max-width: 1px;
    border: none;
}

QWidget#settingNavRow {
    border-radius: 10px;
}

QWidget#settingNavRow[active="true"] {
    background: #3a3a3a;
}

QLabel#settingNavIconSlot {
    background: transparent;
    border-radius: 5px;
}

QLabel#settingNavIconSlot[active="true"] {
    background: #3a3a3a;
}

QPushButton#settingNavBtn {
    min-height: 40px;
    text-align: left;
    color: #d1d5db;
    font-size: 16px;
    font-weight: 700;
    padding: 0 10px;
    border: none;
    border-radius: 8px;
    background: transparent;
}

QWidget#settingNavRow[active="true"] QPushButton#settingNavBtn {
    color: #f9fafb;
}

QFrame#settingContentPage {
    background: #2d2d2d;
    border: 1px solid #404040;
    border-radius: 10px;
}

QLabel#settingSubSectionTitle {
    font-size: 14px;
    font-weight: 700;
    color: #f3f4f6;
}

QFrame#settingDisclaimer {
    background: #3b2a16;
    border: 2px solid #d97706;
    border-radius: 8px;
}

QLabel#settingDisclaimerTitle {
    background: transparent;
    color: #fed7aa;
    font-size: 16px;
    font-weight: 700;
}

QLabel#settingDisclaimerText {
    background: transparent;
    color: #ffedd5;
    font-size: 14px;
}

QFrame#settingItemDivider {
    background: #4a4a4a;
    min-height: 1px;
    max-height: 1px;
    border: none;
}


QComboBox {
    background: #353535;
    color: #f3f4f6;
    padding: 0 8px;
}

QLineEdit,
NoWheelSpinBox {
    background: #353535;
    color: #f3f4f6;
}

QRadioButton {
    color: #f3f4f6;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
}

QRadioButton::indicator:unchecked {
    border: 2px solid #9ca3af;
    border-radius: 7px;
    background: #2d2d2d;
}

QRadioButton::indicator:checked {
    border: 2px solid #2563eb;
    border-radius: 7px;
    background: #2563eb;
}

QPushButton#settingSaveBtn,
QPushButton#settingCloseBtn,
QPushButton#settingResetBtn,
QPushButton#settingUserManualBtn,
QPushButton#settingStartServiceBtn,
QPushButton#settingStartRecordingBtn,
QPushButton#settingModelFilesBtn {
    min-height: 34px;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    padding: 0 14px;
}

QPushButton#settingSaveBtn {
    background: #2563eb;
    color: #ffffff;
}

QPushButton#settingSaveBtn:hover {
    background: #1d4ed8;
}

QPushButton#settingSaveBtn:pressed {
    background: #1e40af;
}

QPushButton#settingCloseBtn {
    background: #9ca3af;
    color: #111827;
}

QPushButton#settingCloseBtn:hover {
    background: #6b7280;
}

QPushButton#settingCloseBtn:pressed {
    background: #4b5563;
    color: #f9fafb;
}

QPushButton#settingUserManualBtn,
QPushButton#settingStartServiceBtn,
QPushButton#settingStartRecordingBtn,
QPushButton#settingModelFilesBtn {
    background: #f59e0b;
    color: #ffffff;
}

QPushButton#settingUserManualBtn:hover,
QPushButton#settingStartServiceBtn:hover,
QPushButton#settingStartRecordingBtn:hover,
QPushButton#settingModelFilesBtn:hover {
    background: #d97706;
}

QPushButton#settingUserManualBtn:pressed,
QPushButton#settingStartServiceBtn:pressed,
QPushButton#settingStartRecordingBtn:pressed,
QPushButton#settingModelFilesBtn:pressed {
    background: #b45309;
}

QPushButton#settingModelFilesBtn:disabled {
    background: #4b5563;
    color: #9ca3af;
}

QPushButton#settingResetBtn {
    background: #dc2626;
    color: #ffffff;
}

QPushButton#settingResetBtn:hover {
    background: #b91c1c;
}

QPushButton#settingResetBtn:pressed {
    background: #991b1b;
}

QPushButton#settingNormalButton {
    border: 1px solid #666666;
    border-radius: 8px;
    background: #3a3a3a;
    color: #f3f4f6;
    font-size: 13px;
    font-weight: 600;
    padding: 0 2px;
}

QPushButton#settingNormalButton:hover {
    background: #4a4a4a;
}

QPushButton#settingNormalButton:pressed {
    background: #2f2f2f;
}

QWidget#settingModelFilesRow {
    min-height: 36px;
}

QLineEdit#settingModelFilesDesc {
    color: #a1a1aa;
    font-size: 13px;
    font-weight: 500;
    border: none;
    background: transparent;
    padding: 0;
}

QWidget#settingModelFilesBlockOverlay {
    background-color: rgba(0, 0, 0, 148);
}

QFrame#interactionOverlayPanel {
    background: #2c2c2c;
    border: 1px solid #575757;
    border-radius: 10px;
    min-width: 360px;
    max-width: 460px;
}

QLabel#interactionOverlayTitle {
    color: #f3f4f6;
    font-size: 14px;
    font-weight: 700;
}

QProgressBar#interactionOverlayProgress {
    min-height: 12px;
    border: 1px solid #575757;
    border-radius: 6px;
    background: #3a3a3a;
    text-align: center;
    color: #f3f4f6;
}

QProgressBar#interactionOverlayProgress::chunk {
    border-radius: 5px;
    background: #2563eb;
}
