/* Base */
QWidget {
    color: #1f2937;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 14px;
}

/* Home */
QWidget#homeView {
    background: #000000;
}

QLabel#homeVideoLabel {
    color: #374151;
    font-size: 24px;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.72);
    padding: 8px 12px;
    border-radius: 8px;
}

QPushButton#homeSettingBtn {
    background: rgba(255, 255, 255, 0.92);
    color: #111827;
    border: 1px solid #111827;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
}

QPushButton#homeSettingBtn:hover {
    background: #ffffff;
}

QPushButton#homeSettingBtn:pressed {
    background: #e5e7eb;
}

QPushButton#homeExitBtn {
    background: #dc2626;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
}

QPushButton#homeExitBtn:hover {
    background: #b91c1c;
}

QPushButton#homeExitBtn:pressed {
    background: #991b1b;
}

QPlainTextEdit#homeDebugInfo {
    background-color: rgba(230, 230, 230, 170);
}

QPushButton#homeRecordStopBtn {
    background: #dc2626;
    color: #ffffff;
    border: none;
    border-radius: 14px;
    font-size: 28px;
    font-weight: 700;
    padding: 16px 20px;
    text-align: center;
}

QPushButton#homeRecordStopBtn:hover {
    background: #b91c1c;
}

QPushButton#homeRecordStopBtn:pressed {
    background: #991b1b;
}

QWidget#homeCallBlockOverlay {
    background-color: rgba(0, 0, 0, 96);
}

QFrame#homeModelFilesHint {
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid #d1d5db;
    border-radius: 8px;
}

QLabel#homeModelFilesHintText {
    color: #111827;
    font-size: 16px;
    font-weight: 600;
}

QLabel#homeModelFilesHintIcon {
    background: transparent;
}

QPushButton#homeCallCloseBtn {
    background: #d92d20;
    color: #ffffff;
    border: none;
    border-radius: 18px;
    font-size: 36px;
    font-weight: 700;
    padding: 24px 36px;
}

QPushButton#homeCallCloseBtn:hover {
    background: #b42318;
}

QPushButton#homeCallCloseBtn:pressed {
    background: #912018;
}

/* Setting popup */
QWidget#settingOverlay {
    background-color: rgba(0, 0, 0, 120);
}

QFrame#settingPanel {
    background: #ffffff;
    border-radius: 12px;
}

QLabel#settingTitle {
    font-size: 22px;
    font-weight: 700;
    color: #111827;
}

QFrame#settingLeftNav {
    background: #ffffff;
    border-radius: 10px;
}

QScrollArea#settingLeftScroll,
QScrollArea#settingRightScroll {
    background: transparent;
}

QFrame#settingCenterDivider {
    background: #e5e7eb;
    min-width: 1px;
    max-width: 1px;
    border: none;
}

QWidget#settingNavRow {
    border-radius: 10px;
}

QWidget#settingNavRow[active="true"] {
    background: #e5e7eb;
}

QLabel#settingNavIconSlot {
    background: transparent;
    border-radius: 5px;
}

QLabel#settingNavIconSlot[active="true"] {
    background: #e5e7eb;
}

QPushButton#settingNavBtn {
    min-height: 40px;
    text-align: left;
    color: #374151;
    font-size: 16px;
    font-weight: 700;
    padding: 0 10px;
    border: none;
    border-radius: 8px;
    background: transparent;
}

QWidget#settingNavRow[active="true"] QPushButton#settingNavBtn {
    color: #1f2937;
}

QFrame#settingContentPage {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
}

QLabel#settingSubSectionTitle {
    font-size: 14px;
    font-weight: 700;
    color: #1f2937;
}

QFrame#settingDisclaimer {
    background: #fff7ed;
    border: 2px solid #f59e0b;
    border-radius: 8px;
}

QLabel#settingDisclaimerTitle {
    background: transparent;
    color: #9a3412;
    font-size: 16px;
    font-weight: 700;
}

QLabel#settingDisclaimerText {
    background: transparent;
    color: #7c2d12;
    font-size: 14px;
}

QFrame#settingItemDivider {
    background: #c6ced8;
    min-height: 1px;
    max-height: 1px;
    border: none;
}


QRadioButton {
    color: #111827;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
}

QRadioButton::indicator:unchecked {
    border: 2px solid #6b7280;
    border-radius: 7px;
    background: #ffffff;
}

QRadioButton::indicator:checked {
    border: 2px solid #2563eb;
    border-radius: 7px;
    background: #2563eb;
}

QPushButton#settingSaveBtn,
QPushButton#settingCloseBtn,
QPushButton#settingResetBtn,
QPushButton#settingUserManualBtn,
QPushButton#settingStartServiceBtn,
QPushButton#settingStartRecordingBtn,
QPushButton#settingModelFilesBtn {
    min-height: 34px;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    padding: 0 14px;
}

QPushButton#settingSaveBtn {
    background: #2563eb;
    color: #ffffff;
}

QPushButton#settingSaveBtn:hover {
    background: #1d4ed8;
}

QPushButton#settingSaveBtn:pressed {
    background: #1e40af;
}

QPushButton#settingCloseBtn {
    background: #9ca3af;
    color: #111827;
}

QPushButton#settingCloseBtn:hover {
    background: #6b7280;
}

QPushButton#settingCloseBtn:pressed {
    background: #4b5563;
    color: #f9fafb;
}

QPushButton#settingUserManualBtn,
QPushButton#settingStartServiceBtn,
QPushButton#settingStartRecordingBtn,
QPushButton#settingModelFilesBtn {
    background: #f59e0b;
    color: #ffffff;
}

QPushButton#settingUserManualBtn:hover,
QPushButton#settingStartServiceBtn:hover,
QPushButton#settingStartRecordingBtn:hover,
QPushButton#settingModelFilesBtn:hover {
    background: #d97706;
}

QPushButton#settingUserManualBtn:pressed,
QPushButton#settingStartServiceBtn:pressed,
QPushButton#settingStartRecordingBtn:pressed,
QPushButton#settingModelFilesBtn:pressed {
    background: #b45309;
}

QPushButton#settingModelFilesBtn:disabled {
    background: #d1d5db;
    color: #6b7280;
}

QPushButton#settingResetBtn {
    background: #dc2626;
    color: #ffffff;
}

QPushButton#settingResetBtn:hover {
    background: #b91c1c;
}

QPushButton#settingResetBtn:pressed {
    background: #991b1b;
}

QPushButton#settingNormalButton {
    border: 1px solid #d1d5db;
    border-radius: 8px;
    background: #f3f4f6;
    color: #1f2937;
    font-size: 13px;
    font-weight: 600;
    padding: 0 2px;
}

QPushButton#settingNormalButton:hover {
    background: #e5e7eb;
}

QPushButton#settingNormalButton:pressed {
    background: #d1d5db;
}

QWidget#settingModelFilesRow {
    min-height: 36px;
}

QLineEdit#settingModelFilesDesc {
    color: #4b5563;
    font-size: 13px;
    font-weight: 500;
    border: none;
    background: transparent;
    padding: 0;
}

QWidget#settingModelFilesBlockOverlay {
    background-color: rgba(0, 0, 0, 148);
}

QFrame#interactionOverlayPanel {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.16);
    border-radius: 10px;
    min-width: 360px;
    max-width: 460px;
}

QLabel#interactionOverlayTitle {
    color: #111827;
    font-size: 14px;
    font-weight: 700;
}

QProgressBar#interactionOverlayProgress {
    min-height: 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    background: #f3f4f6;
    text-align: center;
}

QProgressBar#interactionOverlayProgress::chunk {
    border-radius: 5px;
    background: #2563eb;
}
